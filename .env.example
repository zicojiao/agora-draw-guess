# Public site origin used for canonical links and metadata.
# Local default:
VITE_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Gate the whole site only when BOTH values are set.
# Leave them empty for a normal local game.
# Generate the cookie secret with: openssl rand -hex 32
ACCESS_PASSWORD=
ACCESS_COOKIE_SECRET=

# Cloudflare Worker that guards D1. Browsers never see the key.
# Generate one with: openssl rand -hex 32
# Use the same value in `wrangler secret put DATABASE_SERVICE_KEY`.
DATABASE_SERVICE_URL=
DATABASE_SERVICE_KEY=

# Optional voice. Without these, the drawing game still runs.
# Agora Console → your project → App ID / App Certificate.
# The certificate is server-only.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Vision. Default is DeepSeek Flash, which reads the drawing.
# OPENAI_API_KEY is the key for AI_API_BASE_URL. Leave the key empty in git.
# To use OpenAI instead, point the base URL at https://api.openai.com/v1
# and set OPENAI_VISION_MODEL to a vision model that host serves.
OPENAI_API_KEY=
AI_API_BASE_URL=https://api.deepseek.com
OPENAI_VISION_MODEL=deepseek-flash

# Optional. Leave empty to keep the built-in shared canvas.
AGORA_WHITEBOARD_APP_IDENTIFIER=
AGORA_WHITEBOARD_ACCESS_KEY=
AGORA_WHITEBOARD_SECRET_KEY=
AGORA_WHITEBOARD_REGION=us-sv
